windowDef Desktop
{
	rect	0,0,1120,480		
	nocursor 1

	
		onNamedEvent Text_Message_1_Anim_Out { 
			transition "Mover1_4_3::rect" "0 0 300 100" "300 0 300 100" "750" ;
			transition "Mover1_16_9::rect" "0 0 300 100" "300 0 300 100" "750" ;
			transition "Mover1_16_10::rect" "0 0 300 100" "300 0 300 100" "750" ;
			transition "Mover1_21_9::rect" "0 0 300 100" "300 0 300 100" "750" ;
		}

		onNamedEvent Text_Message_1_Anim_in {			
			transition "Mover1_4_3::rect" "300 0 300 100" "0 0 300 100" "250" ;
			transition "Mover1_16_9::rect" "300 0 300 100" "0 0 300 100" "250" ;
			transition "Mover1_16_10::rect" "300 0 300 100" "0 0 300 100" "250" ;
			transition "Mover1_21_9::rect" "300 0 300 100" "0 0 300 100" "250" ;
			localsound "sound/shav/general/message_in.ogg"
		}

		onNamedEvent Text_Message_2_Anim_Out {		
