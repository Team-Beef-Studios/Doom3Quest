						rect 0, 12.5, 200, 12.5 * "gui::text_message_1_lines" - 12.5
						visible 1 - "gui::text_message_1_type"
				
						background "guis/assets/roundedsquare_2_middle.tga"
						matcolor 0.15,0.15,0.15,.95

