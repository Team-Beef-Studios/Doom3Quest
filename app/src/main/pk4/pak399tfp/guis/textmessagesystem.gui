	windowDef Desktop_4_3
	{
		rect	0,0,640,480
		noTime	1
		visible	"gui::aspect_0_visible"		
		shadow	1
		forceaspectwidth	640

		windowDef TextMessages2
		{ 
			rect 640 - 225, 20, 225, 480				
			forceaspectwidth	1120
			

			windowDef Typing
			{
				rect 0, 12.5 * "gui::text_message_typing_linepos", 240, 25
				visible "gui::text_message_typing_visible"

				forceaspectwidth	640
		
				windowDef Dots
				{
					rect 20, 5, 205, 20			
					textscale 0.15
					forecolor 1, 1, 1, .9
					font "fonts/an"					
					//notime 1

					forceaspectwidth	640

					onTime 0
					{
						set "Text" "Lee is typing";
					}

					onTime 500
					{
						set "Text" "Lee is typing.";
					}

					onTime 1000
					{
						set "Text" "Lee is typing..";
					}

					onTime 1500
					{
						set "Text" "Lee is typing...";
					}

					onTime 2000
					{
						resetTime 0;
					}
				}

				windowDef ProfileCircle_In
				{
					rect 0, 2, 20, 20			
			
					background "guis/assets/circle.tga"
					matcolor 0.4,0.8,1,.9

					forceaspectwidth	640

					windowDef ProfilePicture
					{
						rect 0,0, 20, 20
						visible 1
			
						background "guis/assets/lee_portrait_textmessage.tga"
						matcolor 1,1,1,1

						forceaspectwidth	640
					}
				}
			}

			windowDef Message1_Out
			{
				rect 25 * "gui::text_message_1_type", 12.5 * "gui::text_message_1_linepos", 240, 12.5 + 12.5 * "gui::text_message_1_lines"
