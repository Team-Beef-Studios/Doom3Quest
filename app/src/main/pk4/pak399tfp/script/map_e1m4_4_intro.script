	float still_calling = 0;
	void Karl_Calling()
	{
		still_calling = 1;
		while(still_calling == 1)
		{			
			thread ShowNPCSubtitles("?", "*knocking*", 2);
			Intro_CharacterSays($Karl_Knock_Clicker, "sound/shav/e1m4_4/knock_1.ogg");
			
			if(still_calling == 0)
				break;

			sys.wait(5);

			if(still_calling == 0)
				break;

			thread ShowNPCSubtitles("?", "Hey? Hello? You there?", 2);
			Intro_CharacterSays($Karl_Knock_Clicker, "sound/vo/e1m4_4/karlmotel/karl1_alt.ogg");

			sys.wait(5);

			if(still_calling == 0)
				break;

			thread ShowNPCSubtitles("?", "*knocking*", 2);
			Intro_CharacterSays($Karl_Knock_Clicker, "sound/shav/e1m4_4/knock_2.ogg");
			
			if(still_calling == 0)
				break;

			sys.wait(5);

			if(still_calling == 0)
				break;

			thread ShowNPCSubtitles("?", "*knocking*", 2);
			Intro_CharacterSays($Karl_Knock_Clicker, "sound/shav/e1m4_4/knock_3.ogg");

			sys.wait(5);

			if(still_calling == 0)
				break;
		}
	}

	void Karl2Sub()
	{
		ShowNPCSubtitles("?", "I stay in the apartment next to you.\nI don't mean to be putting my nose where it doesn't belong.", 4.5);
		ShowNPCSubtitles("?", "But I overheard you and that other girl earlier.", 4);
	}

	void Karl6Sub()
	{
		ShowNPCSubtitles("Karl", "I heard about your whole situation with the borders.", 3);
		ShowNPCSubtitles("Karl", "I heard you're trying to get out.\nAnd I heard that you have failed spectacularly so far.", 5);
	}
	
	void Karl8Sub()
	{
		ShowNPCSubtitles("Karl", "You do that. Don't let people hear you. People are crazy!", 4);		
		ShowNPCSubtitles("Karl", "Hey. I don't know why you want to get out. Most people are trying to get in.", 4.5);		
		ShowNPCSubtitles("Karl", "BUT, that is none of my business. Fact is you want to get out.\nFact is I have helped people achieve that goal in the past.", 6.5);		
		ShowNPCSubtitles("Karl", "Allegedly.", 2);
	}
	
	void Karl9Sub()
	{
		ShowNPCSubtitles("Karl", "It's a pretty involved process with many intricate steps.", 2.25);
		ShowNPCSubtitles("Karl", "You don't need to worry about that, just leave it to the pros.", 3);		
		ShowNPCSubtitles("Karl", "You don't need to know how the hotdog is made.\nYou get what I'm saying?", 3);		
		ShowNPCSubtitles("Karl", "Hey, I can do it. I can do it, no question.\nBut I just have to warn you.", 4.25);
		ShowNPCSubtitles("Karl", "Getting out is the easy part.\nGetting back in, that's where it gets tricky.", 6.5);
	}
	
	void Karl10Sub()
	{
		ShowNPCSubtitles("Karl", "If we're going through with this you better be sure.\nYou better be damn sure.", 9);		
		ShowNPCSubtitles("Karl", "Of course, the federacy is spreading like cancer.\nLike cancer!", 4.25);
		ShowNPCSubtitles("Karl", "And eventually it will consume everything.", 2.5);
		ShowNPCSubtitles("Karl", "They're literally the materialized...\nmanifestation...of the heat death of the universe.", 4.5);		
		ShowNPCSubtitles("Karl", "Point is you may automatically find yourself\nback in federal land because there is nowhere left to go on this planet.", 5);
	}
	
	void karl11Sub()
	{
		ShowNPCSubtitles("Karl", "Yeah okay, so. Okay, so unfortunately.\nUnfortunately it's not a cheap thing to do.", 5.5);		
		ShowNPCSubtitles("Karl", "In fact, it's a pretty expensive process we're talking about here.\nI take my cut of the money.", 5.5);		
		ShowNPCSubtitles("Karl", "It's a totally symbolic and miniscule amount of money of course.\nYou get that.", 6);
	}

	void Karl13sub()
	{
		ShowNPCSubtitles("Karl", "Hey hey hey. I think you're nice and all.\nYou have a smooth voice, but.", 3.5);
		ShowNPCSubtitles("Karl", "I like to keep my identity anonymous.\nYou know what I'm getting at?", 4.5);		
		ShowNPCSubtitles("Karl", "I don't want to wake up one day not waking up, you know?", 3.5);
		ShowNPCSubtitles("Karl", "I know the people you're dealing with and I am staying well away from that.", 4);		
		ShowNPCSubtitles("Karl", "I'm already running a giant risk here. You get that.", 3);		
		ShowNPCSubtitles("Karl", "Look. The two of you talk it out once whatshername\ngets her pretty little thing back to the motel.", 5);		
		ShowNPCSubtitles("Karl", "I like her. She's...", 2.75);
		ShowNPCSubtitles("Karl", "Anyway should you decide to seek my expertise, I will be in this apartment the rest of the week.\nAfter that, I'm gone.", 7.5);		
		ShowNPCSubtitles("Karl", "And I'm hard to find.\n Think about it. Call me.", 4.5);
	}	

	void KarlTalkOne()
	{
		still_calling = 0;
		$Karl_Knock_Clicker.stopSound(SND_CHANNEL_ANY, 0);
		
		thread ShowNPCSubtitles("?", "Hey? You there?", 2);		
		CharacterSays($motel_karl_speaker_one, "sound/vo/e1m4_4/karlmotel/karl1.ogg");
		
		Beat(1);
		
		thread ShowNPCSubtitles("Sam", "Uhm...yeah? Who's there?", 3);
		CharacterSays($player1, "sound/vo/e1m4_4/karlmotel/player1.ogg");
		
		Beat(.25);
		
		thread Karl2Sub();
		CharacterSays($motel_karl_speaker_one, "sound/vo/e1m4_4/karlmotel/karl2.ogg");
		
		Beat(.75);

		thread ShowNPCSubtitles("Sam", "Overheard what?", 2);
		CharacterSays($player1, "sound/vo/e1m4_4/karlmotel/player2.ogg");
				
		Beat(.25);
		
		thread ShowNPCSubtitles("?", "I think I can help you. No, I know I can help you. Head inside.\nCall my room. It's number 10. Use the motel line.", 9);
		CharacterSays($motel_karl_speaker_one, "sound/vo/e1m4_4/karlmotel/karl3.ogg");
		
		Beat(1.5);
		
		thread ShowNPCSubtitles("Sam", "Yeah...", 2);
		CharacterSays($player1, "sound/vo/e1m4_4/karlmotel/player3.ogg");
		
		Beat(1);
		
		$altan_door_clicker.setKey("clickonce", 1);
		$altan_door_clicker.setKey("item_disabled", 0);
	}
	
