	float stillCalling = 1;

	void ExitWindow()
	{
		sys.fadeTo('0 0 0', 1, .25);
		
		$WindowClicker.startSoundShader("sound/shav/intro/openwindow.ogg", SND_CHANNEL_ANY);

		sys.wait(2);

		$RoomFog.move(UP, 2048);

		sys.trigger($info_player_teleport_1);

		sys.fadeTo('0 0 0', 0, 1);

		sys.wait(5);

		thread ShowNPCSubtitles("Kaylee", "Hey! Are you there? Come on. I'm here.", 3);
		Intro_CharacterSays($FenceClicker, "sound/vo/e1m4_4/ep1intro/Lee6.ogg");

		sys.trigger($FenceClicker);

		while(stillCalling == 1)
		{
			sys.wait(5);

			if(stillCalling == 0)
				break;

			thread ShowNPCSubtitles("Kaylee", "Come here.", 2);
			Intro_CharacterSays($FenceClicker, "sound/vo/e1m4_4/ep1intro/Lee6_1.ogg");
			
			if(stillCalling == 0)
				break;

			sys.wait(5);

			if(stillCalling == 0)
				break;

			thread ShowNPCSubtitles("Kaylee", "Hey dickwad.", 2);
			Intro_CharacterSays($FenceClicker, "sound/vo/e1m4_4/ep1intro/Lee6_2.ogg");
			
			if(stillCalling == 0)
				break;

			sys.wait(5);

			if(stillCalling == 0)
				break;

			thread ShowNPCSubtitles("Kaylee", "Hello?", 2);
			Intro_CharacterSays($FenceClicker, "sound/vo/e1m4_4/ep1intro/Lee6_3.ogg");
		}
	}

	void BackToVoid()
	{
		sys.trigger($info_player_teleport_marble);
		
		$laser_room_camera_rotator.time(0.01);
		$laser_room_camera_rotator.accelTime(0);
		$laser_room_camera_rotator.decelTime(0);
		$laser_room_camera_rotator.rotateOnce('0 0 -90');
		sys.trigger($laser_room_camera);
		sys.wait(.125);
		$laser_room_camera_mover.time(6);
		$laser_room_camera_mover.accelTime(0);
		$laser_room_camera_mover.decelTime(2);
		$laser_room_camera_mover.moveToPos($player1.getWorldOrigin() + '0 0 1' * $player1.getEyeHeight());
		sys.fadeTo('0 0 0', 0, 3);

		sys.wait(3.75);
		sys.trigger($SpeakerVoidLoop);

		$laser_room_camera_rotator.time(2);
		$laser_room_camera_rotator.accelTime(.5);
		$laser_room_camera_rotator.decelTime(.25);
		$laser_room_camera_rotator.rotateOnce('0 0 90');		

		sys.waitFor($laser_room_camera_mover);
		
		sys.trigger($laser_room_camera);

		sys.wait(1);

		thread ShowNPCSubtitles("Samantha", "Not again! What does it want this time?", 3);
		Intro_CharacterSays($player1, "sound/vo/e1m4_4/milesintro/SpawnReaction.ogg");		
	}

	void Lee10Sub()
	{
		sys.showSubtitle("Kaylee", "Wow a year? Let's stay out here for an hour. And make it two.");
		
		sys.wait(5);
		
		sys.showSubtitle("Kaylee", "I totally want to see you grounded in room prison.\nStripes look good on you.");
	}

	void UpdateSpookyCamFov()
	{
		float astart = 60;
		float aend = 135;
		float aduration = 14;
		
		float lastFrame = sys.getTime();
		float endTime = lastFrame + aduration;

		while(1)
		{
			float t = sys.getTime() - lastFrame;
			t /= aduration;

			if(t > 1.0)
			{
				break;
			}

			float fov = astart + t * (aend - astart);
			$intro_spookydoor_cam.setKey("fov", fov);

			sys.waitFrame();
		}
	}

	void TalkFence()
	{
		stillCalling = 0;
		$FenceClicker.stopSound(SND_CHANNEL_ANY,0);

		thread ShowNPCSubtitles("Kaylee", "Took your sweet time girl.", 2);
		Intro_CharacterSays($LeeSpeaker, "sound/vo/e1m4_4/ep1intro/Lee7.ogg");

		Beat(.45);

		thread ShowNPCSubtitles("Samantha", "Hey I'm not your girl.", 2);
		Intro_CharacterSays($player1, "sound/vo/e1m4_4/ep1intro/miles1.ogg");

		Beat(.75);

		sys.showSubtitle("Kaylee", "You are so my girl.");
		Intro_CharacterSays($LeeSpeaker, "sound/vo/e1m4_4/ep1intro/Lee8.ogg");

		Beat(.55);

		sys.showSubtitle("Samantha", "Whatever man. So what did you want?");
		Intro_CharacterSays($player1, "sound/vo/e1m4_4/ep1intro/miles2.ogg");

		Beat(.65);

		sys.showSubtitle("Kaylee", "I desperately wanted your company.\nIn fact. I need it.");
		Intro_CharacterSays($LeeSpeaker, "sound/vo/e1m4_4/ep1intro/Lee9.ogg");

		Beat(.75);

		sys.showSubtitle("Samantha", "Now? It's almost midnight.\nThey're gonna ground me for a year if they find out.");
		Intro_CharacterSays($player1, "sound/vo/e1m4_4/ep1intro/miles3.ogg");

		Beat(.6);
		
		thread Lee10Sub();
		Intro_CharacterSays($LeeSpeaker, "sound/vo/e1m4_4/ep1intro/Lee10.ogg");
		 
		Beat(.3);

		sys.showSubtitle("Samantha", "Stripes don't look good on anybody.\nBut you can be my prison wife.");
		Intro_CharacterSays($player1, "sound/vo/e1m4_4/ep1intro/miles4.ogg");

		Beat(.5);

		sys.showSubtitle("Kaylee", "Yeah, no. I'm gonna be out here, free as a bird.\nLiving next door to a criminal mastermind weirdo.");
		Intro_CharacterSays($LeeSpeaker, "sound/vo/e1m4_4/ep1intro/Lee11.ogg");

		Beat(.25);

		thread ShowNPCSubtitles("Samantha", "You're the weirdo.", 2);
		Intro_CharacterSays($player1, "sound/vo/e1m4_4/ep1intro/miles5.ogg");

		Beat(1.75);
		
		Intro_CharacterSays($LeeSpeaker, "sound/vo/e1m1/Intro/Sigh.ogg");

		Beat(.7);
		
		sys.trigger($speaker_1092);

		Beat(.15);		

		sys.showSubtitle("Kaylee", "Look. Samuel got his letter today.\nOf acceptance. You know?");
		Intro_CharacterSays($LeeSpeaker, "sound/vo/e1m4_4/ep1intro/Lee12.ogg");

		Beat(1.75);

		sys.showSubtitle("Kaylee", "He'll be going away. Soon.");
		Intro_CharacterSays($LeeSpeaker, "sound/vo/e1m4_4/ep1intro/Lee13.ogg");		

		Beat(.55);

		sys.showSubtitle("Samantha", "He'll come back.");
		Intro_CharacterSays($player1, "sound/vo/e1m4_4/ep1intro/miles6.ogg");

		Beat(1);

		sys.showSubtitle("Kaylee", "That's what he tells me too.\nBut I know it's just a lie.");
		Intro_CharacterSays($LeeSpeaker, "sound/vo/e1m4_4/ep1intro/Lee14.ogg");		

		Beat(.35);

		sys.showSubtitle("Samantha", "He would never lie to you.");
		Intro_CharacterSays($player1, "sound/vo/e1m4_4/ep1intro/miles7.ogg");

		Beat(.5);

		$player1.startSoundShader("sound/shav/e1m4_4/inescapable", SND_CHANNEL_ANY);

		sys.showSubtitle("Kaylee", "Everybody lies.");
		Intro_CharacterSays($LeeSpeaker, "sound/vo/e1m4_4/ep1intro/Lee15.ogg");

		Beat(1.0);

		sys.showSubtitle("Samantha", "But he's your brother.");
		Intro_CharacterSays($player1, "sound/vo/e1m4_4/ep1intro/miles8.ogg");
		
		Beat(.35);

		sys.showSubtitle("Kaylee", "But he's leaving.");
		Intro_CharacterSays($LeeSpeaker, "sound/vo/e1m4_4/ep1intro/Lee16.ogg");		

		Beat(.75);

		sys.showSubtitle("Samantha", "I will still be here.");
		Intro_CharacterSays($player1, "sound/vo/e1m4_4/ep1intro/miles9.ogg");

		sys.trigger($SpeakerShitShitShit);

		Beat(1.4);

		crossFadeEnt ($ParentsWindow, offColor, onColor, .0625);

		Beat(.5);

		sys.showSubtitle("Kaylee", "Yeah I don't know.\nDoes your prison allow visitors?");
		Intro_CharacterSays($LeeSpeaker, "sound/vo/e1m1/Intro/Lee17.ogg");			

		Beat(.5);

		sys.showSubtitle("Samantha", "Come on. They're not that bad...");
		Intro_CharacterSays($player1, "sound/vo/e1m4_4/ep1intro/miles10.ogg");

		crossFadeEnt ($ExtraLight, offColor, onColor, .0625);
		crossFadeEnt ($ExtraLightEffect, offColor, onColor, .0625);

		Beat(.15);

		sys.trigger($SpeakerSceneBreak);
		
		sys.showSubtitle("Kaylee", "Shit shit shit. Your parents.\nYou. Me. Our place. Tomorrow.");
		Intro_CharacterSays($LeeSpeaker, "sound/vo/e1m1/Intro/Lee18.ogg");
		sys.hideSubtitles();

		sys.fadeTo('0 0 0', 1, 1);

		sys.wait(.9);

		sys.trigger($SpeakerCrickets);

		sys.wait(4);

		sys.fadeTo('0 0 0', 0, .5);

		// CHANGE TO SPOOKY DOOR CAM
		sys.trigger($intro_spookydoor_cam);
		
		$intro_spookydoor_cam_mover.moveTo($intro_spookydoor_target);
		$intro_spookydoor_cam_mover.rotateOnce('0 0 20');

		sys.wait(8);
		thread UpdateSpookyCamFov();
		
		sys.wait(2);

		$intro_spookydoor_mover.rotateOnce('0 105 0');

		sys.wait(2);

		sys.trigger($intro_spookydoor_light);
		
		sys.wait(19);

		sys.fadeTo('0 0 0', 1, 3);

		sys.wait(3);

		sys.waitFor($intro_spookydoor_cam_mover);

		BackToVoid();
	}

	float portal_dest_marble = 0;
	float portal_dest_prae = 1;
	float portal_dest_record = 2;
	float portal_dest_void = 3;	
	float portal_dest_max = 3;

	float portal_dest_prae_locked = 0;
	float portal_dest_record_locked = 1;

	float currentDst = 3;
	float currentSrc = 0;

	entity GetPortalEntityNamed(string name, string type)
	{
		return sys.getEntity("void_toggle_portal_" + name + "_" + type);
	}	

	entity GetPortalEntity(float dst, string type)
	{
		string s;

		if(dst == portal_dest_marble)
		{
			s = "marble";
		}
		else if(dst == portal_dest_prae)
		{
			s = "praeleanthor";
		}
		else if(dst == portal_dest_record)
		{
			s = "record";
		}
		else
		{
			// DEFAULT IS VOID
			s = "void";
		}

		return GetPortalEntityNamed(s, type);
	}

	vector GetPortalColor(float dst)
	{
		entity e = GetPortalEntity(dst, "color");
		return e.getVectorKey("_color_light");
	}

	void TogglePortal()
	{		
		entity srcAnchor = GetPortalEntity(currentSrc, "anchor");
		entity srcClicker = GetPortalEntity(currentSrc, "clicker");
		entity srcDoor = GetPortalEntity(currentSrc, "door1");
		entity srcLight_1 = GetPortalEntity(currentSrc, "light_1");
		entity srcLight_2 = GetPortalEntity(currentSrc, "light_2");
		entity srcCrystal = GetPortalEntity(currentSrc, "crystal");		
		entity srcClip = GetPortalEntity(currentSrc, "clip");
		vector srcColor = GetPortalColor(currentSrc);

		entity dstAnchor = GetPortalEntity(currentDst, "anchor");
		entity dstClicker = GetPortalEntity(currentDst, "clicker");
		entity dstDoor = GetPortalEntity(currentDst, "door1");
		entity dstLight_1 = GetPortalEntity(currentDst, "light_1");
		entity dstLight_2 = GetPortalEntity(currentDst, "light_2");
		entity dstCrystal = GetPortalEntity(currentDst, "crystal");
		//entity dstClip = GetPortalEntity(currentDst, "clip");
		vector dstColor = GetPortalColor(currentDst);
		
		vector src_origin = srcAnchor.getWorldOrigin();
		vector pl_origin = $player1.getWorldOrigin();

		vector velocity = (pl_origin - src_origin);
		float distance = sys.vecLength(velocity);

		vector box_radius = '64 64 64';

		vector min = src_origin - box_radius;
		vector max = src_origin + box_radius;

		if( pl_origin_x < src_origin_x - box_radius_x ||
			pl_origin_x > src_origin_x + box_radius_x ||
			pl_origin_y < src_origin_y - box_radius_y ||
			pl_origin_y > src_origin_y + box_radius_y)
		{
			$player1.startSoundShader("sound/shav/blueworld/outofrange.ogg", SND_CHANNEL_ANY);
			srcClicker.setKey("click_item", 1);
			return;
		}

		srcClip.show();

		thread crossFadeEnt (srcLight_1, srcColor, dstColor, 1.25);
		thread crossFadeEnt (srcLight_2, srcColor, dstColor, 1.25);
		thread crossFadeEnt (srcCrystal, srcColor, dstColor, 1.25);
		thread crossFadeEnt (dstLight_1, srcColor, dstColor, 1.25);
		thread crossFadeEnt (dstLight_2, srcColor, dstColor, 1.25);
		thread crossFadeEnt (dstCrystal, srcColor, dstColor, 1.25);		

		sys.trigger(srcDoor);
		sys.wait(0.1);
		sys.waitFor(srcDoor);

		srcClip.hide();

		sys.wait(0.5);

		if(currentDst == portal_dest_prae && portal_dest_prae_locked)
		{
			srcDoor.startSoundShader("shav_general_alarm5", SND_CHANNEL_ANY);
			sys.wait(2);

			thread ShowNPCSubtitles("Samantha", "I can't go back there.\nI'm not sure I want to either...", 3.5);
			thread CharacterSays($player1, "sound/vo/e1m4_4/milesintro/TeleportDoorReaction.ogg");

			thread crossFadeEnt (srcLight_1, dstColor, srcColor, 1.25);
			thread crossFadeEnt (srcLight_2, dstColor, srcColor, 1.25);
			thread crossFadeEnt (srcCrystal, dstColor, srcColor, 1.25);
			thread crossFadeEnt (dstLight_1, dstColor, srcColor, 1.25);
			thread crossFadeEnt (dstLight_2, dstColor, srcColor, 1.25);
			thread crossFadeEnt (dstCrystal, dstColor, srcColor, 1.25);		

			sys.trigger(srcDoor);
			sys.wait(0.1);
			sys.waitFor(srcDoor);

			sys.wait(0.5);

			srcClicker.setKey("click_item", 1);
		}
		else if(currentDst == portal_dest_record && portal_dest_record_locked)
		{
			srcDoor.startSoundShader("shav_general_alarm5", SND_CHANNEL_ANY);
			sys.wait(2);

			thread crossFadeEnt (srcLight_1, dstColor, srcColor, 1.25);
			thread crossFadeEnt (srcLight_2, dstColor, srcColor, 1.25);
			thread crossFadeEnt (srcCrystal, dstColor, srcColor, 1.25);
			thread crossFadeEnt (dstLight_1, dstColor, srcColor, 1.25);
			thread crossFadeEnt (dstLight_2, dstColor, srcColor, 1.25);
			thread crossFadeEnt (dstCrystal, dstColor, srcColor, 1.25);		

			sys.trigger(srcDoor);
			sys.wait(0.1);
			sys.waitFor(srcDoor);

			sys.wait(0.5);

			srcClicker.setKey("click_item", 1);
		}
		else
		{
			pl_origin = $player1.getWorldOrigin();
			vector dst_origin = dstAnchor.getWorldOrigin();			

			$player1.setWorldOrigin(dst_origin + (pl_origin - src_origin));
		
			float tmp = currentDst;
			currentDst = currentSrc;
			currentSrc = tmp;		

			sys.wait(0.5);

			sys.trigger(dstDoor);
			sys.wait(0.1);
			sys.waitFor(dstDoor);

			sys.wait(0.5);

			dstClicker.setKey("click_item", 1);
		}
	}

	void ChangePortal()
	{
		entity srcIndicator = GetPortalEntity(currentDst, "color");
		vector srcColor = GetPortalColor(currentDst);

		currentDst = (currentDst + 1) % portal_dest_max;
		
		entity dstIndicator = GetPortalEntity(currentDst, "color");
		vector dstColor = GetPortalColor(currentDst);

		//$void_portal_changer.move(270, 4);
		//sys.waitFor($void_portal_changer);

		float angle_uwu = -22.333;
		vector angle_vec = '1 0 0' * angle_uwu;
		if(currentDst == 0)
			angle_vec = '1 0 0' * 2 * -angle_uwu;

		$void_toggle_portal_rotator.startSoundShader("sound/shav/e1m4_4/voidswitchshort.ogg", SND_CHANNEL_ANY);
		$void_toggle_portal_rotator.rotateOnce(angle_vec);

		sys.waitFor($void_toggle_portal_rotator);

		$player1.startSoundShader("sound/shav/blueworld/anote", SND_CHANNEL_ANY);

		thread crossFadeEnt (srcIndicator, srcColor, srcColor * 0.125, 0.5);
		thread crossFadeEnt (dstIndicator, dstColor * 0.125, dstColor, 0.5);

		$void_toggle_portal_clicker.setKey("item_disabled", 0);
	}
	
	float praeleanthoring = 1;
	void UpdatePraeleanthorCam()
	{
		while(praeleanthoring)
		{
			$praeleanthor_camview.setAngles($player1.getViewAngles());

			sys.waitFrame();
		}
	}	

	void PraleanthorTalk()
	{
		thread UpdatePraeleanthorCam();

		thread ShowNPCSubtitles("???", "Samantha Miles", 3);
		CharacterSays($player1, "sound/vo/e1m4_4/milesintro/praleanthor1.ogg");

		// Set the camera and mover to the position of the player
		$praeleanthor_camview.setOrigin($player1.getOrigin() + '0 0 1' * 72);
		$praeleanthor_camview_mover.setOrigin($player1.getOrigin() + '0 0 1' * 72);
		$praeleanthor_camview.bind($praeleanthor_camview_mover);
		$praeleanthor_camview.setAngles($player1.getViewAngles());

		// Change to the camera view
		sys.trigger($praeleanthor_camview);
		$player1.setOrigin($praeleanthor_teleport_dst.getOrigin());

		// Move the camera to the destination
		$praeleanthor_camview_mover.moveTo($praeleanthor_dst);		
		$player1.startSoundShader("sound/shav/e1m4_4/boots.ogg", SND_CHANNEL_ANY);
		thread UpdateCameraBlur($praeleanthor_camview, 0.0, 0.5, 1);
		sys.fadeFromTo('1 0 0', 0.0, '1 0 0', 0.25, 1);

		// Start the music
		sys.trigger($SpeakerPraeleanthorMusic);		
		
		Beat(1);

		thread UpdateCameraBlur($praeleanthor_camview, 0.5, 0.0, 2);

		Beat(1);

		$praeleanthor_camview_mover.time(3);
		$praeleanthor_camview_mover.move(UP, 128);
		
		$player1.startSoundShader("sound/shav/e1m4_4/gasp.ogg", SND_CHANNEL_ANY);

		thread ShowNPCSubtitles("???", "We are one. We are many.\nWe are the Praeleanthor.", 12);
		CharacterSays($player1, "sound/vo/e1m4_4/milesintro/praleanthor3.ogg");
		
		Beat(.75);		
		
		thread ShowNPCSubtitles("Samantha", "The rooms keep changing. It's hard to...\nI came as fast as I could.", 5);
		CharacterSays($player1, "sound/vo/e1m4_4/milesintro/miles1.ogg");
		
		Beat(.75);
		
		thread ShowNPCSubtitles("Praeleanthor", "You forget yourself.\nYour excuses are of no concern to me.", 8);
		CharacterSays($player1, "sound/vo/e1m4_4/milesintro/praleanthor2.ogg");
		
		Beat(.75);
		
		thread ShowNPCSubtitles("Samantha", "I did what you asked.\nHe should be on the way to the device.", 4.25);
		CharacterSays($player1, "sound/vo/e1m4_4/milesintro/miles2.ogg");

		Beat(.75);
		
		thread ShowNPCSubtitles("Praeleanthor", "Your tone betrays you.", 3);
		CharacterSays($player1, "sound/vo/e1m4_4/milesintro/praleanthor2_1.ogg");

		Beat(.75);
		
		thread ShowNPCSubtitles("Samantha", "There's nothing more I can do.\nPlease...", 3);
		CharacterSays($player1, "sound/vo/e1m4_4/milesintro/miles3.ogg");

		Beat(.75);
		
		thread ShowNPCSubtitles("Praeleanthor", "That is not for you to decide.", 4);
		CharacterSays($player1, "sound/vo/e1m4_4/milesintro/praleanthor2_2.ogg");

		Beat(.75);
		
		thread ShowNPCSubtitles("Samantha", "But he's on his way...", 2);
		thread CharacterSays($player1, "sound/vo/e1m4_4/milesintro/miles4.ogg");
		
		Beat(1);

		$praeleanthor_camview_mover.time(.5);
		$praeleanthor_camview_mover.move(DOWN, 160);

		sys.wait(.4);
		$player1.startSoundShader("sound/shav/e1m4_4/thud.ogg", SND_CHANNEL_ANY);

		Beat(3);
		
		thread ShowNPCSubtitles("Praeleanthor", "Do you see the crystal on the floor?", 4);
		CharacterSays($player1, "sound/vo/e1m4_4/milesintro/praleanthor4.ogg");							

		sys.wait(1);

		$player1.startSoundShader("sound/shav/blueworld/poof.ogg", SND_CHANNEL_ANY);

		sys.wait(0.25);

		sys.trigger($void_praeleanthor_crystal);
		sys.trigger($void_praeleanthor_crystal_light);
		sys.trigger($void_praeleanthor_crystal_light_glare);
		sys.trigger($void_praeleanthor_crystal_clip);
	}

	float marble_state = 0;
	void PraeleanthorContinue()
	{
		Beat(.75);
		
		thread ShowNPCSubtitles("Samantha", "Yes.", 2);
		CharacterSays($player1, "sound/vo/e1m4_4/milesintro/miles6.ogg");
		
		Beat(.75);
		
		thread ShowNPCSubtitles("Praeleanthor", "What is its color?", 3);
		CharacterSays($player1, "sound/vo/e1m4_4/milesintro/praleanthor5.ogg");
		
		Beat(.75);
		
		thread ShowNPCSubtitles("Samantha", "It's blue.", 2);
		CharacterSays($player1, "sound/vo/e1m4_4/milesintro/miles7.ogg");
		
		sys.wait(1);
		$player1.startSoundShader("sound/shav/blueworld/wineglass.ogg", SND_CHANNEL_ANY);

		sys.wait(1);
		
		thread crossFadeEnt ($void_praeleanthor_crystal, blue_crystal_color, red_crystal_color, 4);
		thread crossFadeEnt ($void_praeleanthor_crystal_light, blue_crystal_color, red_crystal_color, 4);
		thread crossFadeEnt ($void_praeleanthor_crystal_light_glare, blue_crystal_color, red_crystal_color, 4);

		Beat(2.75);
		
		thread ShowNPCSubtitles("Praeleanthor", "No.", 2);
		CharacterSays($player1, "sound/vo/e1m4_4/milesintro/praleanthor6.ogg");
		
		Beat(2.25);

		thread ShowNPCSubtitles("Praeleanthor", "Your construct has been instanced.\nLeave us.", 6);
		CharacterSays($player1, "sound/vo/e1m4_4/milesintro/praleanthor7.ogg");

		sys.trigger($void_toggle_portal_praeleanthor_door1);

		sys.wait(2);
		
		marble_state = 1;
		$void_marble_light_clicker.setKey("click_item", "1");		

		$void_toggle_portal_record_switch.show();
		$void_toggle_portal_record_switch2.show();		

		sys.wait(1);

		$player1.startSoundShader("sound/shav/e1m4_4/boots2.ogg", SND_CHANNEL_ANY);
		$void_toggle_portal_praeleanthor_clicker.setKey("item_disabled", 1);		

		sys.wait(.25);

		$praeleanthor_camview_mover.moveTo($praeleanthor_dst_end);
		sys.waitFor($praeleanthor_camview_mover);
		
		sys.fadeFromTo('1 0 0', 0.25, '1 0 0', 0, 1);
		sys.trigger($praeleanthor_camview);

		// DO THE WATER MILL STUFF
		$iamwater.show();
		$iamawheel.rotate('15 0 0');

		// DO THE PISTON STUFF
		thread GogoPiston();


		portal_dest_prae_locked = 1;
		portal_dest_record_locked = 0;
		TogglePortal();

		sys.wait(1);

		praeleanthoring = 0;
	}

	void SetBlock(float row, float num)
	{
		if(num > 6)
		{
			num = 6;
		}

		vector red = '1 0 0';
		vector green = '0 1 0';
		vector blue = '0 1 1';
		vector magenta = '1 0 1';

		float j = 0;
		while(j < 6)
		{
			vector color = '0 0 0';

			if(j < num)
			{
				float t = j / 6;
				vector colorA = t * red + (1-t) * green;			
				vector colorB = t * magenta + (1-t) * blue;
				t = row / 12;

				color = t * colorB + (1-t) * colorA;
			}

			entity block = sys.getEntity("benson_radio_eq_" + row + "_" + j);
			block.setColor(color_x, color_y, color_z);

			j++;
		}
	}

	void RunEq()
	{
		float i = 0;
		while(1)
		{
			i = 0;
			while(i < 12)
			{
				float r = 1 + Floor(sys.random(6), 6);

				SetBlock(i, r);

				i++;
			}
			sys.wait(.125);
		}
	}

	float benson_lights_ongoing = 1;
	void BensonRadioLights()
	{
		while(benson_lights_ongoing)
		{
			$benson_camera_radio_light_mover.move(270, 1024);
			thread crossFadeEnt ($benson_camera_radio_light, '0 0 0', '0.36 0.26 0.08', 1);

			sys.waitFor($benson_camera_radio_light_mover);
			$benson_camera_radio_light.setColor(0,0,0);

			$benson_camera_radio_light.unbind();
			$benson_camera_radio_light_mover.setOrigin($benson_camera_radio_light_spawner.getOrigin());
			$benson_camera_radio_light.setOrigin($benson_camera_radio_light_spawner.getOrigin());
			sys.wait(0.1);
			$benson_camera_radio_light.bind($benson_camera_radio_light_mover);			
			sys.wait(0.1);
		}
	}

	void MoveTrunkRoad()
	{	
		$benson_camera_trunk_road_mover.move(180, 80);		
		sys.waitFor($benson_camera_trunk_road_mover);
		$benson_camera_trunk_road_mover.move(180, -80);
		sys.waitFor($benson_camera_trunk_road_mover);
		$benson_camera_trunk_road_mover.move(180, 80);
		sys.waitFor($benson_camera_trunk_road_mover);
		$benson_camera_trunk_road_mover.move(180, -80);
	}

	void Intro_Setup()
	{
		thread RunEq();
		thread BensonRadioLights();

		$barn_car_light_mover.rotateOnce('0 180 0');
		$intro_benson_speedo_needle_rotator.rotateOnce('-45 0 0');

		// Set up the camera position and rotation
		$func_mover_13.rotateOnce('90 0 0');
		$func_mover_13.move(UP, 64);
	}

