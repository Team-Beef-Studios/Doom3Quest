	void IntroPanning()
	{
		sys.fadeTo('1 1 1', 1, 0.1);
		
		Intro_Setup();

		Intro_ShowLamp_1();

		sys.wait(4.9);

		sys.trigger($SpeakerHeart);		

		sys.wait(4.3);

		Intro_ShowLamp_2(13.4);

		sys.wait(4.3);
		
		Intro_ShowRoad(8.7);

		//Intro_ShowTrunk(4.3);

		sys.wait(2.3);

		$player1.startSoundShader("sound/shav/e1m4_4/car_accel", SND_CHANNEL_ANY);

		sys.wait(2);

		Intro_ShowSpeedometer(8.7);

		//sys.wait(0.5);

		Intro_ShowRadio(8.725);

		sys.wait(4.35);
		// 56.775

		thread Intro_BackSeatLighting();
		Intro_ShowBackSeat_1(4.4);
		Intro_ShowBackSeat_2(4.3);
		Intro_ShowBackSeat_3(4.3);

		//69.775
		
		sys.wait(4.35);

		Intro_ShowTreelinePanning(13.2);

		sys.wait(4.3);

		Intro_ShowRoadSide(8.75);

		//sys.wait(1);

		Intro_ShowTrafficLights(8.65);

		Intro_ShowMotelSign(21.875);

		Intro_ShowMotelLobby(8.7);

		Intro_ShowMotelCourtyard(8.7);

		Intro_ShowMotelRooms(8.7);
		
		Intro_ShowHeadlights(8.7);

		Intro_ShowBarn(80.7);		

		sys.wait(2.5);

		sys.trigger($func_cameraview_5);
		sys.fadeTo('1 1 1', 0, 0.1);

		showTextCamDuration("Sam", $cameraGui2, 0, 5);
		sys.wait(1);

		sys.fadeFromTo('1 1 1', 0, '1 1 1', 1, 1);
		sys.wait(1);

		BackToMotel();

		sys.fadeFromTo('1 1 1', 1, '1 1 1', 0, 2);		
	}	
	
