	float Floor(float value, float max)
	{
		float i = max;

		while(i > 0)
		{
			if(value < i && value > i - 1)
				return i - 1;

				i--;
		}
		return value;
	}

	void LeeTexts(string text)
	{
		float textTime = sys.strLength(text) * 0.125;

		sys.showTextTyping();
		sys.wait(textTime);
		sys.hideTextTyping();
		sys.showTextMessage(text, 0);
	}
		
	void ShowText(string text, float type)
	{
		if(type == 0)
		{
			sys.showTextTyping();
			sys.wait(2);
			sys.hideTextTyping();
		}

		sys.showTextMessage(text, type);
	}

	void SubtitlesRunning()
	{
		while(hideSubTime > sys.getTime())
		{			
			sys.waitFrame();
		}
		sys.hideSubtitles();
	}

	void ShowNPCSubtitles(string name, string titles, float duration)
	{
		sys.showSubtitle(name, titles);
		hideSubTime = sys.getTime() + duration;
		sys.wait(duration);
		if(hideSubTime <= sys.getTime())
		{
			sys.hideSubtitles();
		}
		else
		{
			thread SubtitlesRunning();
		}
	}

	void Intro_CharacterSays(entity characterEntity, string line)
	{
		sys.wait(characterEntity.startSoundShader(line, SND_CHANNEL_ANY));
	}
	
	void Intro_CharacterSaysInterupt(entity characterEntity, string line, float interrupt)
    {
		sys.wait(characterEntity.startSoundShader(line, SND_CHANNEL_ANY) - interrupt);
    }	

	void CharacterSays(entity characterEntity, string line)
	{
		sys.wait(characterEntity.startSoundShader(line, SND_CHANNEL_ANY));
	}
	
	float CharacterSays2(entity characterEntity, string line)
	{
		return characterEntity.startSoundShader(line, SND_CHANNEL_ANY);
	}
	
	float Beat(float delay)
	{
		sys.wait(delay);
		return delay;
	}

	void MovePiston(entity piston)
	{
		while(true)
		{
			piston.move(0, 76);
			sys.waitFor(piston);
			sys.wait(1);
			piston.move(180, 76);
			sys.waitFor(piston);
			sys.wait(1);
		}
	}
	
	void GogoPiston()
	{
		thread MovePiston($iamapiston_01);
		sys.wait(9);
		thread MovePiston($iamapiston_02);
		sys.wait(9);
		thread MovePiston($iamapiston_03);
	}

