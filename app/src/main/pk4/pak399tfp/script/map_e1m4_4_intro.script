	void KarlTalkTwo()
	{
		$func_static_100455.setKey("click_item", "1");
		$func_static_100081.setKey("click_item", "1");
		$func_static_100080.setKey("click_item", "1");
		$func_static_100082.setKey("click_item", "1");
		$func_static_107939.setKey("click_item", "1");
