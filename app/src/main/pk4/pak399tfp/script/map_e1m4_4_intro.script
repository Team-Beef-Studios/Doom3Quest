	void BombGetUp()
	{
		sys.trigger($bomb_area_fadein_relay);

		float blurAlpha = 1.0;

		while(camOffsetZ < 72)
		{
			camOffsetZ += 0.25;
			
			$bomb_wakeup_camera.setKey("blurAlpha", blurAlpha);
			blurAlpha -= 0.01f;
			sys.wait(.001);
		}

		sys.trigger($bomb_wakeup_camera);
		sys.trigger($setinfluence_motel);
	}	
	
	float suspendBlurCam = 0;
	void UpdateBlurCam()
	{
		while(1)
		{			
			if(!suspendBlurCam)
			{
				$bomb_wakeup_camera.setOrigin($player1.getOrigin() + '0 0 1' * camOffsetZ);
				$bomb_wakeup_camera.setAngles($player1.getViewAngles());
			}

			sys.waitFrame();
		}
	}

	void BombWakeUp()
	{
		sys.trigger($info_teleport_bombroom);
		thread UpdateBlurCam();

		sys.fadeTo('0 0 0', 1, 0);
		
		//MUSIC STARTS
		sys.trigger($bomb_wakeup_insanity_speaker);
		
		//GOTO CAMERA
		sys.trigger($bomb_wakeup_camera);
	
		sys.wait(5);
		
		//MILES CALLS
		thread ShowNPCSubtitles("Miles", "Sam? Sam....Sam?....Saaam!", 10);
		sys.trigger($bomb_wakeup_miles_calling_out_speaker);
		
		sys.wait(5);
		
		//START BREATHING
		sys.trigger($bomb_wakeup_breathing_speaker);		
					
		sys.wait(5);
		
		//FADE IN FROM BLACK
		sys.fadeTo('0 0 0', 0, 2.5);
		
		sys.wait(2.5);
		
		//FADE TO BLACK
		sys.fadeTo('0 0 0', 1, 2.5);
		
		sys.wait(2.5);

		// SUSPEND CRAWLING
		suspendBlurCam = 1;
		$bomb_wakeup_camera.setKey("updatePosition", 0);
		$bomb_wakeup_camera.setKey("updateView", 0);

		sys.wait(3);
		
		// REMOVED VOID TALK

		// RESUME CRAWLING
		suspendBlurCam = 0;
		$bomb_wakeup_camera.setKey("updatePosition", 1);
		$bomb_wakeup_camera.setKey("updateView", 1);
		
		sys.wait(2.5);

		//FADE IN FROM BLACK
		sys.fadeTo('0 0 0', 0, 2.5);
		
		//MOVE CAMERA A BIT FORWARD IN SMALL CHUNKS
		//$bomb_wakeup_camera_mover.move(270, 28);
		sys.wait(5);
		//$bomb_wakeup_camera_mover.move(270, 28);
		
		//FADE OUT A TINY BIT
		sys.fadeTo('0 0 0', 0.5, 2.5);
		
		//MORE CRAWLING
		$bomb_wakeup_camera_mover.move(270, 28);
		
		//FADE FULLY IN
		sys.fadeTo('0 0 0', 0, 2.5);

		sys.wait(3);

		sys.quickSave("Plan B - Checkpoint 1");
		sys.trigger($trigger_relay_1);
	}

