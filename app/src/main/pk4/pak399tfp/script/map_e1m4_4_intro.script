	float isTalking = 0;
	void ContinueLeeTalk()
	{		
		$bathroom_water_particle.show();		

		$leeback_curtain_1.hide();
		$leeback_curtain_2.show();

		Intro_CharacterSays($continue_talk_item, "sound/shav/e1m4_4/knock_4.ogg");

		sys.wait(1.5);

		$continue_talk_item.hide();

		$motel_bathroom_handle_ik_os.startSoundShader("e1m1_doorknobopen", SND_CHANNEL_ANY);
		$motel_bathroom_handle_ik_os.rotateOnce('0 0 -30');

		thread CharacterSays($door_bathroom_mover, "sound/shav/e1m1/doorknobopen.ogg");
		$door_bathroom_mover.rotateOnce('0 -65 0');

		sys.wait(.75);

		$motel_bathroom_handle_ik_os.rotateOnce('0 0 30');

		sys.disableItemGroup("motel");
		
		isTalking = 1;

		thread ShowNPCSubtitles("Sam", "You're in a good mood.\nI take it Plan B went well?", 3);
		CharacterSays($player1, "sound/vo/e1m4_4/motel/Player5.ogg");
		
		Beat(.25);
		
		thread ShowNPCSubtitles("Lee", "So well!", 2.5);
		CharacterSays($motel_bathroom_speaker_lee, "sound/vo/e1m4_4/motel/Lee5.ogg");
		
		Beat(1.75);
		
		thread ShowNPCSubtitles("Sam", "Well that's good I guess.\nDid you get the box back?", 3);
		CharacterSays($player1, "sound/vo/e1m4_4/motel/Player6.ogg");
		
		Beat(.25);
		
		thread LeeMotel6Subs();
		CharacterSays($motel_bathroom_speaker_lee, "sound/vo/e1m4_4/motel/Lee6.ogg");
		
		Beat(.75);
		
		thread ShowNPCSubtitles("Sam", "Apparently so.\nI'm working on a lead.", 3.5);
		CharacterSays($player1, "sound/vo/e1m4_4/motel/Player7.ogg");

		Beat(.5);
		
		thread ShowNPCSubtitles("Lee", "A lead? You get leads?", 3);
		CharacterSays($motel_bathroom_speaker_lee, "sound/vo/e1m4_4/motel/Lee7.ogg");

		Beat(.35);
		
		thread ShowNPCSubtitles("Sam", "I can get leads...", 2);
		CharacterSays($player1, "sound/vo/e1m4_4/motel/Player8.ogg");
		
		Beat(.25);
		
		thread ShowNPCSubtitles("Lee", "When??", 2);
		CharacterSays($motel_bathroom_speaker_lee, "sound/vo/e1m4_4/motel/Lee8.ogg");

		Beat(.5);
		
		thread PlayerMotel9Subs();
		CharacterSays($player1, "sound/vo/e1m4_4/motel/Player9.ogg");

		Beat(.5);
		
		thread ShowNPCSubtitles("Lee", "The guy next door? That sounds super sketchy, Sam...", 4.5);
		CharacterSays($motel_bathroom_speaker_lee, "sound/vo/e1m4_4/motel/Lee9.ogg");
		
		Beat(.15);
		
		thread ShowNPCSubtitles("Sam", "What? Because 'Plan B' isn't sketchy?", 3);
		CharacterSays($player1, "sound/vo/e1m4_4/motel/Player10.ogg");

		Beat(.75);
		
		thread LeeMotel10Subs();
		CharacterSays($motel_bathroom_speaker_lee, "sound/vo/e1m4_4/motel/Lee10.ogg");

		Beat(1);
		
		thread ShowNPCSubtitles("Sam", "Yeah...So when is he going to join you here?\nHe booked this room for the two of you, right?", 6.25);
		CharacterSays($player1, "sound/vo/e1m4_4/motel/Player11.ogg");

		Beat(.5);
						
		//TURN OFF SHOWER			

		sys.trigger($motel_shower_off);
		sys.trigger($motel_shower_bathwater);
		$motel_shower.fadeSound (SND_CHANNEL_ANY, -100, 10);
		
		Beat(1.5);

		sys.fadeTo('0 0 0', 1, 0);
		
		thread ShowNPCSubtitles("Lee", "I don't know, actually. He doesn't live that far away.\nMaybe he's being a gentleman about things.", 5);
		CharacterSays($motel_bathroom_speaker_lee, "sound/vo/e1m4_4/motel/Lee11.ogg");
		
		Beat(.35);
		
		thread ShowNPCSubtitles("Sam", "Why am I here then?", 2);
		CharacterSays($player1, "sound/vo/e1m4_4/motel/Player12.ogg");		
				
		Beat(.45);
		
		thread ShowNPCSubtitles("Lee", "Because...Well because...you're you.", 4.25);
		CharacterSays($motel_bathroom_speaker_lee, "sound/vo/e1m4_4/motel/Lee12.ogg");
		
		Beat(1);
		
		thread ShowNPCSubtitles("Sam", "I feel like I'm getting in your way.", 2);
		CharacterSays($player1, "sound/vo/e1m4_4/motel/Player13.ogg");
		
		Beat(.25);
		
		thread ShowNPCSubtitles("Lee", "You could never do that.", 2);
		CharacterSays($motel_bathroom_speaker_lee, "sound/vo/e1m4_4/motel/Lee13.ogg");
		
		Beat(1.25);
		
		thread PlayerMotel14Subs();
		CharacterSays($player1, "sound/vo/e1m4_4/motel/Player14.ogg");
		
		Beat(.85);

		thread ShowNPCSubtitles("Lee", "Just us?", 2);
		CharacterSays($motel_bathroom_speaker_lee, "sound/vo/e1m4_4/motel/Lee14.ogg");
		
		
		$SpeakerAway.fadeSound (SND_CHANNEL_ANY, -50, 35);

		sys.wait(2.5);

		//thread ShowNPCSubtitles("Lee", "Wake up.", 2);
		//CharacterSays($player1, "sound/vo/e1m4_4/motel/Lee15.ogg");

		sys.wait(1);

		sys.trigger($func_cameraview_2);

		sys.wait(1);

		sys.trigger($speaker_1106);

		sys.fadeTo('0 0 0', 0, 2);

		sys.wait(4);

		sys.fadeTo('0 0 0', 1, 2);

		sys.wait(3);

		BombWakeUp();

		sys.trigger($SpeakerAway);
	}
	
	float motel_reactions = 0;
	float sitting_enable_done = 0;
	float karl_done = 0;

	void UpdateSitItem()
	{
		if(sitting_enable_done == 0 && motel_reactions > 1 && karl_done == 1)
		{
			sitting_enable_done = 1;
			$sit_item.setKey("click_item", 1);
		}
	}
	
	void CondomReaction()
	{
		if(hasCondomReaction == 0)
		{
			hasCondomReaction = 1;
			
