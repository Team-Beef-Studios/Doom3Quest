	float crystal_state_1 = 0;
	float crystal_state_2 = 0;
	float crystal_state_3 = 0;

	float crystal_doors_unlocked = 0;
	void TryLasers()
	{
		sys.disableItemGroup("crystal_clickers");

		$crystal_laser_handle_rotator.startSoundShader("sound/shav/e1m4_4/voidswitchshort.ogg", SND_CHANNEL_ANY);
		$crystal_laser_handle_rotator.rotateOnce('50 0 0');

		sys.waitFor($crystal_laser_handle_rotator);		

		if(crystal_doors_unlocked)
		{
			$player1.startSoundShader("sound/shav/blueworld/anote", SND_CHANNEL_ANY);

			if(!$void_toggle_portal_marble_door1.isOpen())
			{
				sys.trigger($void_toggle_portal_marble_door1);
			}
			
			$crystal_laser_clicker.hide();
			$somecrystal_slot_1.hide();
			$somecrystal_slot_2.hide();
			$somecrystal_slot_3.hide();
		}
		else
		{
			$crystal_laser_handle_rotator.startSoundShader("sound/shav/e1m4_4/voidswitchshort.ogg", SND_CHANNEL_ANY);
			$crystal_laser_handle_rotator.rotateOnce('-50 0 0');

			sys.waitFor($crystal_laser_handle_rotator);

			$crystal_laser_clicker.startSoundShader("shav_general_alarm5", SND_CHANNEL_ANY);

			thread crossFadeEnt ($crystal_laser_door_lights_ent, purple_crystal_color, '0 0 0', .25);
			crossFadeEnt ($crystal_laser_door_lights, purple_crystal_color, '0 0 0', .25);
			thread crossFadeEnt ($crystal_laser_door_lights_ent, '0 0 0', purple_crystal_color, .25);
			crossFadeEnt ($crystal_laser_door_lights, '0 0 0', purple_crystal_color, .25);

			sys.wait(.125);
			
			thread crossFadeEnt ($crystal_laser_door_lights_ent, purple_crystal_color, '0 0 0', .25);
			crossFadeEnt ($crystal_laser_door_lights, purple_crystal_color, '0 0 0', .25);
			thread crossFadeEnt ($crystal_laser_door_lights_ent, '0 0 0', purple_crystal_color, .25);
			crossFadeEnt ($crystal_laser_door_lights, '0 0 0', purple_crystal_color, .25);
			
			sys.wait(.125);
			
			thread crossFadeEnt ($crystal_laser_door_lights_ent, purple_crystal_color, '0 0 0', .25);
			crossFadeEnt ($crystal_laser_door_lights, purple_crystal_color, '0 0 0', .25);
			thread crossFadeEnt ($crystal_laser_door_lights_ent, '0 0 0', purple_crystal_color, .25);
			crossFadeEnt ($crystal_laser_door_lights, '0 0 0', purple_crystal_color, .25);

			$crystal_laser_clicker.setKey("click_item", 1);
		}

		sys.enableItemGroups();
	}
	
	vector GetBcBeamColor(float color_bits)
	{
		if(color_bits == 0) return '1 1 1';
		if(color_bits == 1) return red_crystal_color;
		if(color_bits == 2) return green_crystal_color;
		if(color_bits == 3) return yellow_crystal_color;
		if(color_bits == 4) return blue_crystal_color;
		if(color_bits == 5) return purple_crystal_color;
		if(color_bits == 6) return teal_crystal_color;
		if(color_bits == 7) return '1 1 1';
	}

	

	void UpdateCrystalLasers()
	{
		
		float num_crystals = 0;

		float bits = 0;
		
		if(crystal_state_1 == 1) {bits += 1; num_crystals++; }
		if(crystal_state_2 == 1) {bits += 2; num_crystals++; }
		if(crystal_state_3 == 1) {bits += 4; num_crystals++; }

		float i = 0;
		while(i < 4)
		{
			if(i == num_crystals)
			{
				$speaker_laser.fadeSound(i, 0, .125);
			}
			else
			{
				$speaker_laser.fadeSound(i, -100, 2);
			}
			i++;
		}
		
		$mcbeam_0_1.hide();
		$mcbeam_0_2.hide();
		$mcbeam_0_3.hide();
		$mcbeam_0_4.hide();
		$mcbeam_1_2.hide();
		$mcbeam_1_3.hide();
		$mcbeam_1_4.hide();
		$mcbeam_2_3.hide();
		$mcbeam_2_4.hide();
		$mcbeam_3_4.hide();

		if(bits == 0)
		{
			$mcbeam_0_4.show();
		}
		else if(bits == 1)
		{
			$mcbeam_0_1.show();
			$mcbeam_1_4.show();
		}
		else if(bits == 2)
		{
			$mcbeam_0_2.show();
			$mcbeam_2_4.show();
		}
		else if(bits == 3)
		{
			$mcbeam_0_1.show();
			$mcbeam_1_2.show();
			$mcbeam_2_4.show();
		}
		else if(bits == 4)
		{
			$mcbeam_0_3.show();
			$mcbeam_3_4.show();
		}
		else if(bits == 5)
		{
			$mcbeam_0_1.show();
			$mcbeam_1_3.show();
			$mcbeam_3_4.show();
		}
		else if(bits == 6)
		{
			$mcbeam_0_2.show();
			$mcbeam_2_3.show();
			$mcbeam_3_4.show();
		}
		else if(bits == 7)
		{
			$mcbeam_0_1.show();
			$mcbeam_1_2.show();
			$mcbeam_2_3.show();
			$mcbeam_3_4.show();
		}

		$mcbeam_4_5.show();
		$mcbeam_5_6.show();

		vector color = '1 1 1';
		float show_scale = 0.25;
		float color_bits = 0;
		
		$mcbeam_0_1.setColor(color_x*show_scale,color_y*show_scale,color_z*show_scale);
		$mcbeam_0_2.setColor(color_x*show_scale,color_y*show_scale,color_z*show_scale);
		$mcbeam_0_3.setColor(color_x*show_scale,color_y*show_scale,color_z*show_scale);
		$mcbeam_0_4.setColor(color_x*show_scale,color_y*show_scale,color_z*show_scale);

		if(bits & 1)
		{
			color_bits += 1;
			color = GetBcBeamColor(color_bits);
		}

		$mcbeam_1_2.setColor(color_x*show_scale,color_y*show_scale,color_z*show_scale);
		$mcbeam_1_3.setColor(color_x*show_scale,color_y*show_scale,color_z*show_scale);
		$mcbeam_1_4.setColor(color_x*show_scale,color_y*show_scale,color_z*show_scale);

		if(bits & 2)
		{
			color_bits += 2;
			color = GetBcBeamColor(color_bits);
		}

		$mcbeam_2_3.setColor(color_x*show_scale,color_y*show_scale,color_z*show_scale);
		$mcbeam_2_4.setColor(color_x*show_scale,color_y*show_scale,color_z*show_scale);

		if(bits & 4)
		{
			color_bits += 4;
			color = GetBcBeamColor(color_bits);
		}

		$mcbeam_3_4.setColor(color_x*show_scale,color_y*show_scale,color_z*show_scale);

		$mcbeam_4_5.setColor(color_x*show_scale,color_y*show_scale,color_z*show_scale);
		$mcbeam_5_6.setColor(color_x*show_scale,color_y*show_scale,color_z*show_scale);

		if(color_bits == 5)
		{
			crystal_doors_unlocked = 1;
		}
		else
		{
			crystal_doors_unlocked = 0;
		}
		
	}

	void PutSlot1()
	{			
		sys.disableItemGroup("crystal_clickers");

		if(crystal_state_1 == 0)
		{
			crystal_state_1 = 2;
						
			$somecrystal_slot_1.startSoundShader("sound/shav/e1m4_4/crystal_up.ogg", SND_CHANNEL_ANY);
			$somecrystal_1.move(UP, 16);
			sys.waitFor($somecrystal_1);
			crystal_state_1 = 1;
			UpdateCrystalLasers();
		}
		else if(crystal_state_1 == 1)
		{
			crystal_state_1 = 2;

			UpdateCrystalLasers();
			$somecrystal_slot_1.startSoundShader("sound/shav/e1m4_4/crystal_down.down", SND_CHANNEL_ANY);
			$somecrystal_1.move(DOWN, 16);
			sys.waitFor($somecrystal_1);
			crystal_state_1 = 0;
		}
		
		sys.wait(.25);
		
		$somecrystal_slot_1.setKey("click_item", 1);
		sys.enableItemGroups();
	}

