		thread PhoneNextDoor();
		CharacterSays($player1, "sound/shav/e1m4_4/calling_karl.ogg");		

		thread ShowNPCSubtitles("?", "Great. So. You're a man of business I see.\nLet's get to the nitty gritty.", 5);
		thread CharacterSays($speaker_karl_room, "sound/vo/e1m4_4/karlmotel/karl4_muffled.ogg");
		CharacterSays($player1, "sound/vo/e1m4_4/karlmotel/karl4.ogg");
		
		Beat(0.25);
		
		thread ShowNPCSubtitles("Sam", "Hey, hey. Hold on.\nWhat's your name?", 2);
		CharacterSays($player1, "sound/vo/e1m4_4/karlmotel/player4.ogg");
		
		Beat(0.25);
		
		thread ShowNPCSubtitles("?", "You can call me Karl.", 2);
		thread CharacterSays($speaker_karl_room, "sound/vo/e1m4_4/karlmotel/karl5_muffled.ogg");
		CharacterSays($player1, "sound/vo/e1m4_4/karlmotel/karl5.ogg");
		
		Beat(.5);

		thread ShowNPCSubtitles("Sam", "Okay Karl, what did you 'overhear'?", 2);
		CharacterSays($player1, "sound/vo/e1m4_4/karlmotel/player5.ogg");
				
		Beat(.25);
		
		thread Karl6Sub();
		thread CharacterSays($speaker_karl_room, "sound/vo/e1m4_4/karlmotel/karl6_muffled.ogg");
		CharacterSays($player1, "sound/vo/e1m4_4/karlmotel/karl6.ogg");
		
		Beat(.5);
		
		thread ShowNPCSubtitles("Sam", "You have good ears.", 2);
		CharacterSays($player1, "sound/vo/e1m4_4/karlmotel/player6.ogg");
		
		Beat(.25);
		
		thread ShowNPCSubtitles("Karl", "You have thin walls.", 8);
		thread CharacterSays($speaker_karl_room, "sound/vo/e1m4_4/karlmotel/karl7_muffled.ogg");
		CharacterSays($player1, "sound/vo/e1m4_4/karlmotel/karl7.ogg");
		
		Beat(.5);
		
		thread ShowNPCSubtitles("Sam", "I will DEFINITELY keep that in mind.", 2.5);
		CharacterSays($player1, "sound/vo/e1m4_4/karlmotel/player7.ogg");
		
		Beat(.25);
		
		thread Karl8Sub();
		thread CharacterSays($speaker_karl_room, "sound/vo/e1m4_4/karlmotel/karl8_muffled.ogg");
		CharacterSays($player1, "sound/vo/e1m4_4/karlmotel/karl8.ogg");
		
		Beat(.25);

		thread ShowNPCSubtitles("Sam", "Well. How would you, allegedly, help us?", 5);
		CharacterSays($player1, "sound/vo/e1m4_4/karlmotel/player8.ogg");
		
		Beat(.5);
		
		thread Karl9Sub();
		thread CharacterSays($speaker_karl_room, "sound/vo/e1m4_4/karlmotel/karl9_muffled.ogg");
		CharacterSays($player1, "sound/vo/e1m4_4/karlmotel/karl9.ogg");
		
		Beat(.25);

		thread ShowNPCSubtitles("Sam", "Yeah, I don't think we're going back.", 2);
		CharacterSays($player1, "sound/vo/e1m4_4/karlmotel/player9.ogg");
				
		Beat(.5);
		
		thread Karl10Sub();
		thread CharacterSays($speaker_karl_room, "sound/vo/e1m4_4/karlmotel/karl10_muffled.ogg");
		CharacterSays($player1, "sound/vo/e1m4_4/karlmotel/karl10.ogg");
		
		Beat(.25);
		
		thread ShowNPCSubtitles("Sam", "Okay, so if we were to acquire your...services.\nWhat would you need from us? What do you need us to do?", 8.5);
		CharacterSays($player1, "sound/vo/e1m4_4/karlmotel/player10.ogg");
		
		Beat(.5);
		
		thread karl11Sub();
		thread CharacterSays($speaker_karl_room, "sound/vo/e1m4_4/karlmotel/karl11_muffled.ogg");
		CharacterSays($player1, "sound/vo/e1m4_4/karlmotel/karl11.ogg");
		
		Beat(.25);
		
		thread ShowNPCSubtitles("Sam", "Of course...", 2);
		CharacterSays($player1, "sound/vo/e1m4_4/karlmotel/player11.ogg");
		
		Beat(.5);
		
		thread ShowNPCSubtitles("Karl", "Yeah it's dwarfed by the operational costs. Dwarfed!", 4.5);
		thread CharacterSays($speaker_karl_room, "sound/vo/e1m4_4/karlmotel/karl12_muffled.ogg");
		CharacterSays($player1, "sound/vo/e1m4_4/karlmotel/karl12.ogg");
		
		Beat(.25);
		
		thread ShowNPCSubtitles("Sam", "All right. If we proceed...How do we go about this?\n Should we meet?", 5);
		CharacterSays($player1, "sound/vo/e1m4_4/karlmotel/player12.ogg");
		
		Beat(.5);
		
		thread Karl13sub();
		thread CharacterSays($speaker_karl_room, "sound/vo/e1m4_4/karlmotel/karl13_muffled.ogg");
		CharacterSays($player1, "sound/vo/e1m4_4/karlmotel/karl13.ogg");

		CharacterSays($player1, "sound/shav/e1m4_4/phone_down.ogg");

		karl_done = 1;

		sys.enableItemGroups();

		UpdateSitItem();
	}

	float altan_door_state = 0;
	void OpenAltanDoor()
	{
		if(altan_door_state == 0)
		{
			thread Karl_Calling();
			$Karl_Knock_Clicker.setKey("click_item", "1");

			altan_door_state++;
		}
		else
		{			
			$altan_door_mover.move(180, 35);
			sys.trigger($altan_door_slider_speaker);
		}
	}
	
	void TurnOnLamp()
	{
		$box_lamp_item.startSoundShader("sound/shav/e1m4_4/lamp_on.ogg", SND_CHANNEL_ANY);
		
		thread crossFadeEnt ($sit_item_lamp_light, noLight, lampLightColor, .0625);
		thread crossFadeEnt ($sit_item_lamp_glare, noLight, lampGlareColor, .0625);
		thread crossFadeEnt ($sit_item_lamp_tex, noLight, lampTexColor, .0625);
		
		$box_notes_item.setKey("click_item", "1");
	}

	float boxNotesRead = 0;	

	void PreReadBoxNotes()
	{
		if(boxNotesRead == 0)
		{
			boxNotesRead = 1;

			$box_notes_item.setKey("click_item", "0");
			$box_notes_item.setKey("inspect_delay", "0");

			sys.fadeTo('0 0 0', 1, 0.5);
			sys.wait($player1.startSoundShader("sound/shav/e1m4_4/scribble.ogg", SND_CHANNEL_ANY));
			sys.fadeTo('0 0 0', 0, 0.5);			

			$karl_angle_notes.show();

			$box_notes_item.setKey("click_item", "1");
		}
	}

	void UpdateCameraAngle2()
	{			
		while(sitting == 1)
		{
			$motel_sit_camera.setAngles($player1.getViewAngles() + '0 180 0');
			sys.wait(GAME_FRAMETIME);
		}
	}	
	
	void SitOnChair()
	{
		sitting = 1;
		
		float fade_time = .0625 * 2;

		sys.fadeTo('1 1 1', 1, fade_time);
		sys.wait(fade_time);

		$leeback_coffee_in_machine.show();
		$leeback_coffee_in_mug.show();
		$leeback_mug.show();
		$intro_mug.hide();
		
		sys.waitFrame();

		sys.trigger($sit_box_teleport);
		sys.trigger($motel_sit_camera);
		$box_lamp_item.setKey("click_item", "1");
		$invoice_item.setKey("click_item", "0");
		
		thread UpdateCameraAngle2();
		
		sys.fadeTo('1 1 1', 0, fade_time);
	}

	void showTextCamDuration(string text, entity e, float fade, float duration)
	{
		e.setGuiParm("gui_parm1", text);
		e.setGuiParm("gui_parm2", 0);
		sys.trigger(e);

		if(fade > 0)
		{
			sys.fadeTo('0 0 0', 0, 2);
		}

		sys.wait(duration);

		e.setGuiParm("gui_parm2", 1);
		sys.trigger(e);
	}

	void showTextCam(string text, entity e, float fade)
	{		
		showTextCamDuration(text, e, fade, 7);

		sys.wait(1);
	}

	void showText(string text, float fade)
	{
		entity e = sys.getEntity("cameraGui1");
		showTextCam(text, e, fade);
	}

	void MotelGeomBlur(entity blurgeom, float blurState)
	{
		float max = 1;
		float i = 0;

		while(i <= max)
		{
			i += 0.02f;

			float blur = i;
			if(blurState > 0)
				blur = 1.0 - i;

			blurgeom.setShaderParm( 3, blur);
			sys.wait(0.0625);
		}
	}

	void LeeCalls()
	{
		//Lee texts
		sys.wait(4);
		$motel_item_answer_phone.setKey("click_item", 1);
		$motel_phone_gui.startSoundShader("sound/shav/e1m3/phone_bleep1.ogg", SND_CHANNEL_ANY);
		$motel_phone_gui.setGuiParm("gui_parm1", 1);		
		sys.trigger($motel_phone_gui);
		sys.wait(.5);
		//$player1.startSoundShader("sound/shav/general/message_in.ogg", SND_CHANNEL_ANY);
	}
	
	void BalconyReaction()
	{
		thread ShowNPCSubtitles("Sam", "It's always so quiet here at night.\nI don't know if its soothing or unsettling.", 7.25);
		CharacterSays($player1, "sound/vo/e1m4_4/motel/ViewReaction.ogg");
		Beat(2.5);
		LeeCalls();
