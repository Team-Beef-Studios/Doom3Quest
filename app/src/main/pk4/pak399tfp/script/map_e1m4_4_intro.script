	void AnswerCall()
	{
		thread CharacterSays($player1, "sound/shav/e1m3/pickupbox.ogg");
		
		$motel_phone_model.hide();
		$motel_phone_gui.hide();
		
		$motel_phone_gui.startSoundShader("sound/shav/e1m3/pickupphone.ogg", SND_CHANNEL_ANY);
		
		LeeTexts("Hey...are you still at the motel?\nDo I need to ditch James?");

		sys.wait(3);

		sys.showTextMessage("Yeah still here. Please do...\nSolitaire is getting old.\nDid it go well?", 1);

		sys.wait(2);

		$altan_door_clicker.setKey("item_disabled", 0);
	}

	void EnterMotel()
	{
		sys.disableItemGroup("motel");

		sys.wait(1);
		
		LeeTexts("How do you like the room?\nI've been there before...with dad.\nYou know...the 'CAMPING TRIP'...");

		sys.wait(4);
		
		sys.showTextMessage("When he was at the clinic?\n...So did it go well??", 1);

		sys.wait(1);
		
		LeeTexts("Yeah. I'll tell you about it when I get back...");
		
		sys.wait(3);

		sys.showTextMessage("Yeah the room is nice.\n...So when does he join you here?\nI don't want to be a third wheel....", 1);

		sys.wait(1);
		sys.showTextTyping();

		sys.wait(1);

		sys.enableItemGroups();

		sys.wait(9);
		sys.hideTextTyping();
	}

	vector redbasecolor = '0.8 0.0 0.06';
	vector redlightcolor = '0.2 0.0 0.0';
	vector yellowbasecolor = '0.8 0.7 0.0';
	vector yellowlightcolor = '0.2 0.2 0.0';
	vector greenbasecolor = '0.0 0.8 0.06';
	vector greenlightcolor = '0.0 0.2 0.0';
	
	void AnimateTrafficLight()
	{
		sys.wait(2.5);

		// Fade out green
		thread crossFadeEnt ($trafficlight_base_green, greenbasecolor, greenbasecolor * 0.1, .125);
		thread crossFadeEnt ($trafficlight_light_green, greenlightcolor, noLight, .125);
				
		// Fade in yellow
		thread crossFadeEnt ($trafficlight_base_yellow, yellowbasecolor * 0.1, yellowbasecolor, .125);
		thread crossFadeEnt ($trafficlight_light_yellow, noLight, yellowlightcolor, .125);
		
		sys.wait(2.5);
		
		// Fade out Yellow
		thread crossFadeEnt ($trafficlight_base_yellow, yellowbasecolor, yellowbasecolor * 0.1, .125);
		thread crossFadeEnt ($trafficlight_light_yellow, yellowlightcolor, noLight, .125);
		
		// Fade in red
		thread crossFadeEnt ($trafficlight_base_red, redbasecolor * 0.1, redbasecolor, .125);
		thread crossFadeEnt ($trafficlight_light_red, noLight, redlightcolor, .125);

		sys.wait(1);

		// Fade in yellow2
		thread crossFadeEnt ($trafficlight_base_yellow2, yellowbasecolor * 0.1, yellowbasecolor, .125);
		thread crossFadeEnt ($trafficlight_light_yellow2, noLight, yellowlightcolor, .125);

		sys.wait(2.5);

		// Fade out Red2
		thread crossFadeEnt ($trafficlight_base_red2, redbasecolor, redbasecolor * 0.1, .125);
		thread crossFadeEnt ($trafficlight_light_red2, redlightcolor, noLight, .125);

		// Fade out Yellow2
		thread crossFadeEnt ($trafficlight_base_yellow2, yellowbasecolor, yellowbasecolor * 0.1, .125);
		thread crossFadeEnt ($trafficlight_light_yellow2, yellowlightcolor, noLight, .125);

		// Fade in Green2
		thread crossFadeEnt ($trafficlight_base_green2, greenbasecolor * 0.1, greenbasecolor, .125);
		thread crossFadeEnt ($trafficlight_light_green2, noLight, greenlightcolor, .125);
	}
	
	float lightCounter = 0;		
	vector lampEffectColor = '0.45 0.2 0.14';

	void ToggleLight()
	{
		if(lightCounter < 5)
		{
			$LightClicker.startSoundShader("switch_02", SND_CHANNEL_ANY);			

			if(lightCounter % 2 == 0)
			{
				thread crossFadeEnt ($LampLight, noLight, lampLightColor, .0625);
				thread crossFadeEnt ($LampGlare, noLight, lampGlareColor, .0625);
				thread crossFadeEnt ($LampTex, noLight, lampTexColor, .0625);
				thread crossFadeEnt ($LampEffect, noLight, lampEffectColor, .0625);

				if(lightCounter == 0)
				{
					thread ShowNPCSubtitles("Samantha", "One...", 3);
					CharacterSays($player1, "sound/vo/e1m4_4/ep1intro/milescount1.ogg");
				}
				else if(lightCounter == 2)
				{
					thread ShowNPCSubtitles("Samantha", "Two...", 3);
					CharacterSays($player1, "sound/vo/e1m4_4/ep1intro/milescount2.ogg");
				}
				else if(lightCounter == 4)
				{
					thread ShowNPCSubtitles("Samantha", "Three...", 3);
					CharacterSays($player1, "sound/vo/e1m4_4/ep1intro/milescount3.ogg");
				}
				else
				{
					sys.wait(1);
				}
			}
			else
			{
				thread crossFadeEnt ($LampLight, lampLightColor, noLight, .0625);
				thread crossFadeEnt ($LampGlare, lampGlareColor, noLight, .0625);
				thread crossFadeEnt ($LampTex, lampTexColor, noLight, .0625);
				thread crossFadeEnt ($LampEffect, lampEffectColor, noLight, .0625);				
			}

			lightCounter++;

			$LightClicker.setKey("item_disabled", 0);

			if(lightCounter > 4)
			{
				sys.trigger($LightClicker);

				sys.wait(1);
				
				sys.trigger($WindowClicker);
			}
		}
	}

