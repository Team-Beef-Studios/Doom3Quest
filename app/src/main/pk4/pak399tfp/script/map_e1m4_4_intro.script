		}

		$void_door_reaction_item.setKey("click_item", 1);

		MilesHasTriedLockDoor = 1;
	}

	// Source: https://easings.net/#easeInOutCubic
	// We use this because we don't get any of the accel/decel stuff
	// because we do the updates manually
	float EaseInOutCubic(float x)
	{
		if(x < 0.5)
			return 4 * x * x * x;

		return 1 - sys.pow(-2 * x + 2, 3) * 0.5;
	}

	void UpdateRecordCamera()
	{
		vector final_angles = $record_camera_destination.getAngles();
		vector initial_angles = $player1.getViewAngles();

		vector travel = final_angles - initial_angles;
		
		float now = sys.getTime();
		float then = now + 4.0;

		while(1)
		{
			now = sys.getTime();

			if(now > then)
				break;					

			float t = (4 - (then - now)) * 0.25;

			t = EaseInOutCubic(t);			

			$record_camera.setAngles(initial_angles + travel * t);

			sys.waitFrame();
		}
	}

	void RecordStart()
	{
		$player1.startSoundShader("sound/shav/e1m4_4/restartit.ogg", SND_CHANNEL_ANY);

		vector final_angles = $record_camera_destination.getAngles();
		vector player_angles = $player1.getViewAngles();

		$record_camera_mover.setWorldOrigin($player1.getWorldOrigin() + '0 0 1' * $player1.getEyeHeight());
		$record_camera.setAngles(player_angles);

		$record_camera_mover.time(4);
		$record_camera_mover.accelTime(.05);
		$record_camera_mover.decelTime(.5);
		
		sys.trigger($record_camera);		

		thread UpdateRecordCamera();		
		$record_camera_mover.moveTo($record_camera_destination);

		sys.wait(5.25);

		$player1.startSoundShader("sound/shav/e1m4_4/theemitter.ogg", SND_CHANNEL_ANY);

		sys.wait(0.1);

		$record_camera_mover.time(.125);
		$record_camera_mover.decelTime(0);
		$record_camera_rotator.time(.125);
		$record_camera_rotator.accelTime(.05);

		sys.wait(.8);

		$record_camera_mover.move(270, 32);
		$record_camera_rotator.rotateOnce('-10 0 0');

		sys.waitFor($record_camera_mover);

		sys.wait(1.1);

		$record_camera_mover.move(270, 32);
		$record_camera_rotator.rotateOnce('-10 0 0');

		sys.waitFor($record_camera_mover);

		sys.wait(1.1);

		$record_camera_mover.move(270, 32);
		$record_camera_rotator.rotateOnce('-10 0 0');

		sys.waitFor($record_camera_mover);

		sys.wait(.5);

		$record_camera_mover.time(10);
		$record_camera_mover.accelTime(2);
		$record_camera_rotator.time(7);
		$record_camera_rotator.accelTime(2);

		$void_toggle_portal_record_top.move(UP, 32);
		$void_toggle_portal_record_top.startSoundShader("sound/shav/e1m4_4/recorddoor.ogg", SND_CHANNEL_ANY);
		sys.wait(0.25);
		$void_toggle_portal_record_bottom.move(DOWN, 32);
			
		sys.waitFor($void_toggle_portal_record_bottom);
		
		$record_camera_mover.moveTo($record_camera_target);
		$record_camera_rotator.rotateOnce('-60 0 0');

		// fate out other music
		$SpeakerPraeleanthorMusic.fadeSound (SND_CHANNEL_ANY, -100, 10);
		$SpeakerVoidLoop.fadeSound (SND_CHANNEL_ANY, -100, 10);

		sys.wait(8);
		
		sys.fadeTo('1 1 1', 1, 2);
		sys.wait(1);

		IntroPanning();
		return;
		
		sys.wait(19);

		// Stop the speakers
		sys.trigger($SpeakerPraeleanthorMusic);
		sys.trigger($SpeakerVoidLoop);
	}

	float record_switches = 0;

	void CheckRecordSwitches(float local)
	{
		if(local > 1)
		{
			RecordStart();			
		}
	}

	void FlipRecordSwitch(entity switch, entity sparks, float multiplier)
	{
		switch.startSoundShader("sound/shav/e1m4_4/voidswitch.ogg", SND_CHANNEL_ANY);
		switch.time(.125);		
		switch.rotateOnce('15 0 0' * multiplier);
		sys.waitFor(switch);
		switch.time(.5);

		sys.wait(.5);

		switch.rotateOnce('150 0 0' * multiplier);

		sys.waitFor(switch);

		sys.trigger(sparks);

		sys.wait(.5);

		sys.trigger(sparks);
	}

	void RecordSwitch()
	{
		record_switches++;

		float local = record_switches;

		FlipRecordSwitch($void_toggle_portal_record_switch_mover, $void_toggle_portal_record_sparks, 1);

		CheckRecordSwitches(local);
	}

	void RecordSwitch2()
	{
		record_switches++;

		float local = record_switches;
		
		FlipRecordSwitch($void_toggle_portal_record_switch2_mover, $void_toggle_portal_record_sparks2, -1);

		CheckRecordSwitches(local);
	}	

	vector CWHEEL_lamp_color_on = '1 0.27 0';
	vector CWHEEL_flare_color_on = '0.32549 0.192157 0.019608';
	vector CWHEEL_particle_color_on = '0.066667 0.039216 0.003922';
	float CWHEEL_fade_in_time = 1.0;
	float CWHEEL_fade_out_time = 0.5;

	void RunSingleLight(float index)
	{
		string index_string = "" + index;
		if(index < 10)
			index_string = "0" + index;

		entity lamp = sys.getEntity("structureontop_lamp_" + index_string);
		entity flare = sys.getEntity("structureontop_lamp_" + index_string + "_flare");
		entity particle = sys.getEntity("structureontop_lamp_" + index_string + "_particle");

		thread crossFadeEnt(lamp, '0 0 0', CWHEEL_lamp_color_on, CWHEEL_fade_in_time);
		thread crossFadeEnt(flare, '0 0 0', CWHEEL_flare_color_on, CWHEEL_fade_in_time);
		thread crossFadeEnt(particle, '0 0 0', CWHEEL_particle_color_on, CWHEEL_fade_in_time);

		sys.wait(2);

		thread crossFadeEnt(lamp, CWHEEL_lamp_color_on, '0 0 0', CWHEEL_fade_out_time);
		thread crossFadeEnt(flare, CWHEEL_flare_color_on, '0 0 0', CWHEEL_fade_out_time);
		thread crossFadeEnt(particle, CWHEEL_particle_color_on, '0 0 0', CWHEEL_fade_out_time);
	}

	float lightcolorwheelrunning = 0;
	void RunLightColorWheel()
	{
		lightcolorwheelrunning = 1;

		float i = 0;
		while(lightcolorwheelrunning)
		{			
			if(i == 16)
				i = 0;

			float index = i + 1;

			thread RunSingleLight(index);

			sys.wait(.25);
			
			i++;
		}
	}

