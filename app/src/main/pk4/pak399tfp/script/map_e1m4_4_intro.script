	void UpdateCameraBlur(entity camera, float blurFrom, float blurTo, float duration)
	{
		float blurAlpha = blurFrom;
		float distance = abs(blurFrom - blurTo);

		float stepSize = 0.01f;
		float interval = duration / (distance / stepSize);

		if(blurFrom < blurTo)
		{
			while(blurAlpha < blurTo)
			{
				camera.setKey("blurAlpha", blurAlpha);
				blurAlpha += stepSize;
				sys.wait(interval);
			}
		}
		else
		{
			while(blurAlpha > blurTo)
			{
				camera.setKey("blurAlpha", blurAlpha);
				blurAlpha -= stepSize;
				sys.wait(interval);
			}
		}
	}
	
