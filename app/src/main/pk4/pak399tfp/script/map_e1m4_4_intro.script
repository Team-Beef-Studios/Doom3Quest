	float lee_got_home = 0;
	void LeeGetsHome()
	{
		if(lee_got_home)
			return;

		lee_got_home = 1;

		$box_notes_item.setKey("call_exit", 0);
		$box_notes_item.setKey("inspect_exit_delay", 0);
		//$box_notes_item.setKey("click_item", "1");
		//$box_notes_item.setKey("clickonce", "0");

		sys.trigger($leeback_1_cam);
		sys.trigger($exit_sit_box_teleport);
		$leeback_1_mover.move(UP, 2);
		
		sys.wait(5);

		//$door_bathroom_mover.rotateOnce('0 -15 0');
	
		//sys.wait(10);
	
		$motel_hall_bars.show();
		$motel_coathanger_1.show();
		$motel_coathanger_2.show();
		$motel_coathanger_3.show();
		$motel_coathanger_4.show();
		$motel_coathanger_5.show();
		$motel_coathanger_6.show();
		
		//sys.trigger($lee_open_door_speaker);
		$lee_open_door_speaker.startSoundShader("sound/shav/e1m4_4/door_unlock.ogg", SND_CHANNEL_ANY);
		
		sys.wait(.5);		

		sys.trigger($leeback_portal);
		$leeback_2_door_hinge.rotateOnce('0 -95 0');

		$lee_open_door_speaker.startSoundShader("sound/shav/e1m4_4/door_open.ogg", SND_CHANNEL_ANY);
		sys.waitFor($leeback_2_door_hinge);


		//Turn on hall light
		//thread crossFadeEnt ($hall_light_1, noLight, hall_light_1, .0625);
		//thread crossFadeEnt ($hall_light_2, noLight, hall_light_2, .0625);
		//thread crossFadeEnt ($hall_light_3, noLight, hall_light_3, .0625);
		
		sys.wait(1);					
		
		thread ShowNPCSubtitles("Lee", "Hey! Oh wow. You're still\n'researching'.", 3);
		float lee1_time = CharacterSays2($motel_hallway_speaker_lee, "sound/vo/e1m4_4/motel/Lee1.ogg");
		
		Beat(1.25);

		sys.trigger($leeback_2_cam);
		$leeback_2_mover.move(DOWN, 64);

		Beat(lee1_time - 1.25);

		Beat(.5);

		thread PlayMotel1Sub();
		float player1_time = CharacterSays2($player1, "sound/vo/e1m4_4/motel/Player1.ogg");

		sys.wait(1.25);
		$leeback_2_door_hinge.rotateOnce('0 95 0');

		sys.wait(.5);
		$lee_open_door_speaker.startSoundShader("sound/shav/e1m4_4/enter_foley.ogg", SND_CHANNEL_ANY);

		player1_time -= 1.75;

		sys.trigger($leeback_3_cam);
		$leeback_3_mover.move(90, 48);

		sys.wait(.55);
		player1_time -= .55;

		$lee_open_door_speaker.startSoundShader("sound/shav/e1m4_4/door_close.ogg", SND_CHANNEL_ANY);
		sys.waitFor($leeback_2_door_hinge);
		sys.trigger($leeback_portal);
		
		sys.wait(.5);
		player1_time -= .5;

		sys.wait(player1_time);
		
		thread ShowNPCSubtitles("Lee", "I know what you research when you're all alone!", 3.5);
		CharacterSays($motel_hallway_speaker_lee, "sound/vo/e1m4_4/motel/Lee2.ogg");		

		Beat(.5);

		thread ShowNPCSubtitles("Sam", "Says you...", 2);
		CharacterSays($player1, "sound/vo/e1m4_4/motel/Player2.ogg");
		
		Beat(.75);

		sys.trigger($leeback_3b_cam);
		$leeback_3b_mover.move(270, 36);

		thread ShowNPCSubtitles("Lee", "Anyway. Any luck with the box angle?", 2.5);
		CharacterSays($motel_hallway_speaker_lee, "sound/vo/e1m4_4/motel/Lee3.ogg");		

		Beat(.5);


		thread ShowNPCSubtitles("Sam", "Well maybe.\nWhat about your angle?", 4.5);
		CharacterSays($player1, "sound/vo/e1m4_4/motel/Player3.ogg");

		Beat(1.5);

		sys.trigger($leeback_4_cam);
		$leeback_4_mover.move(315, 2);

		thread ShowNPCSubtitles("Lee", "James? Yeah. Oh. Maybe. He wanted to go out for some dinner.\nSo we...did!", 10);
		CharacterSays($motel_hallway_speaker_lee, "sound/vo/e1m4_4/motel/Lee4.ogg");
		sys.hideSubtitles();

		//Bathroom door sound
		CharacterSays($motel_hallway_speaker_lee, "sound/shav/e1m1/doorknobopen.ogg");

		$lee_bag.show();
		$lee_bag_inspect.setKey("click_item", "1");
		$lee_flannel_jacket.show();

		$door_bathroom_mover.rotateOnce('0 105 0');
		
		sys.wait(2.5);

		$door_bathroom_mover.startSoundShader("sound/shav/e1m4_4/door_close.ogg", SND_CHANNEL_ANY);
		
		$box_notes_item.setKey("call_exit", 0);
		$box_notes_item.setKey("inspect_exit_delay", 0);
		$box_notes_item.setKey("click_item", "1");
		$box_notes_item.setKey("clickonce", "0");
		
		sys.trigger($leeback_4_cam);

		sys.wait(1);

		sitting = 1;

		thread ShowNPCSubtitles("Sam", "That's not all he wants...", 2);
		CharacterSays($player1, "sound/vo/e1m4_4/motel/Player4.ogg");

		sys.wait(1);
		
		sys.trigger($motel_shower_on);

		sys.wait(9);

		$motel_shower.fadeSound (SND_CHANNEL_ANY, -100, 0.00001);

		sys.wait(1);

		sys.trigger($motel_shower);
		$motel_shower.fadeSound (SND_CHANNEL_ANY, -5, 10);
		$motel_shower_on.fadeSound (SND_CHANNEL_ANY, -100, 10);
	}

